(ns forestrysupport.render-html
  "Build-time HTML renderer for `docs/samples/operator-console.html`.

  Closes flagship checklist item 2 (com-junkawasaki/root ADR-2607189300).
  Drives the REAL actor stack (`forestrysupport.operation` ->
  `forestrysupport.governor` -> `forestrysupport.store`) through the same
  scenario shape as `forestrysupport.sim`, rendered deterministically --
  no invented numbers/ids/ops.

  Date contract (iter-54 root cause): store fields
  `:operator-certification-expiry-date` and
  `:equipment-last-inspection-date` are **epoch milliseconds** (see
  `forestrysupport.store` docstring + `registry/*` pure predicates that
  do arithmetic on them). Prior main rewrites used `java.time.LocalDate`
  and exploded with ClassCastException at
  `registry/operator-certification-expired?`. This file mirrors
  `forestrysupport.sim`'s relative epoch-ms helpers.

  Usage: `kbb -M:dev:render-html [out-file]`."
  (:require [kotoba.lang.text :as str]
            [forestrysupport.store :as store]
            [forestrysupport.operation :as op]
            [langgraph.graph :as g]))

;; ----------------------------- harness --------------------------------

(defn- exec! [actor tid request]
  (g/run* actor {:request request} {:thread-id tid}))

(defn- approve! [actor tid]
  (g/run* actor {:approval {:status :approved :by "dispatcher-01"}}
          {:thread-id tid :resume? true}))

(defn- reject! [actor tid]
  (g/run* actor {:approval {:status :rejected :by "dispatcher-01"}}
          {:thread-id tid :resume? true}))

(def ^:private now-ms (System/currentTimeMillis))
(def ^:private ten-days-ago (- now-ms (* 10 24 60 60 1000)))
(def ^:private ten-days-from-now (+ now-ms (* 10 24 60 60 1000)))

(def ^:private clean-fire-support-order
  "Same compliant fire-protection-support order as forestrysupport.sim --
  current certification/inspection (epoch-ms), wind + riparian within
  range, full jp/maff evidence checklist."
  {:service-type :fire-support/patrol-and-fuelbreak-maintenance
   :jurisdiction :jp/maff
   :client-forest-operator-id "forest-42"
   :operator-certification-expiry-date ten-days-from-now
   :equipment-last-inspection-date ten-days-ago
   :wind-speed-kmh 10.0
   :riparian-buffer-actual-m 20.0
   :evidence-checklist [:service-order-record :forest-boundary-map :field-log
                        :operator-certification :equipment-inspection-record
                        :riparian-buffer-assessment]})

(defn run-demo!
  "One seeded MemStore, one compiled StateGraph, five real dispositions:
    1. order-001 :schedule-field-operation auto-commit
    2. order-002 :log-service-record escalate -> approve
    3. order-003 :log-service-record escalate -> reject
    4. order-004 :operate-chainsaw HARD :op-not-allowed
    5. order-999 :schedule-field-operation HARD :service-order-not-registered
  Every id/op is from forestrysupport.sim / governor / store."
  []
  (let [db (store/mem-store {"order-001" clean-fire-support-order
                             "order-002" clean-fire-support-order
                             "order-003" clean-fire-support-order
                             "order-004" clean-fire-support-order})
        actor (op/build db)]
    (exec! actor "t1" {:op :schedule-field-operation :subject "order-001"})
    (exec! actor "t2" {:op :log-service-record :subject "order-002"})
    (approve! actor "t2")
    (exec! actor "t3" {:op :log-service-record :subject "order-003"})
    (reject! actor "t3")
    (exec! actor "t4" {:op :operate-chainsaw :subject "order-004"})
    (exec! actor "t5" {:op :schedule-field-operation :subject "order-999"})
    db))

;; ----------------------------- rendering ------------------------------

(defn- esc [v]
  (-> (str v)
      (str/replace "&" "&amp;")
      (str/replace "<" "&lt;")
      (str/replace ">" "&gt;")))

(defn- last-fact-for [ledger oid]
  (last (filter #(= (:subject %) oid) ledger)))

(defn- hold-rule
  "hold-fact carries both :basis (vector of rule keywords) and
  :violations (vector of {:rule ..} maps). Prefer :basis, fall back."
  [f]
  (or (first (:basis f))
      (some-> f :violations first :rule)))

(defn- status-cell [ledger oid]
  (let [f (last-fact-for ledger oid)]
    (cond
      (nil? f) "<span class=\"muted\">no activity</span>"
      (= :committed (:t f)) "<span class=\"ok\">committed</span>"
      (= :approval-granted (:t f)) "<span class=\"ok\">approved &amp; committed</span>"
      (= :approval-rejected (:t f))
      (str "<span class=\"critical\">rejected"
           (when-let [r (hold-rule f)] (str " &middot; " (esc (name r))))
           "</span>")
      (= :governor-hold (:t f))
      (str "<span class=\"critical\">HARD hold &middot; "
           (esc (name (or (hold-rule f) :unknown)))
           "</span>")
      (= :approval-requested (:t f)) "<span class=\"warn\">awaiting approval</span>"
      :else "<span class=\"muted\">in progress</span>")))

(defn- order-row [cur ledger oid]
  (let [o (store/service-order cur oid)]
    (format "        <tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>"
            (esc oid)
            (esc (str (or (:service-type o) :unregistered)))
            (esc (or (:client-forest-operator-id o) "—"))
            (esc (cond
                   (true? (:logged? o)) "logged"
                   (true? (:scheduled? o)) "scheduled"
                   o "registered"
                   :else "—"))
            (status-cell ledger oid))))

(defn- basis-cell [{:keys [t basis disposition approved-by violations]}]
  (esc
   (or (when (seq basis)
         (->> basis
              (map (fn [b]
                     (cond
                       (keyword? b) (name b)
                       (map? b) (str (or (:rule b) (:spec b) b))
                       :else (str b))))
              (str/join ", ")))
       (when (seq violations)
         (->> violations (map :rule) (map name) (str/join ", ")))
       (when approved-by (str "by " approved-by))
       (some-> disposition name)
       (when (= t :approval-rejected) "rejected")
       "")))

(defn- ledger-row [f]
  (format "        <tr><td>%s</td><td><code>%s</code></td><td>%s</td><td>%s</td></tr>"
          (esc (name (:t f)))
          (esc (name (or (:op f) :n-a)))
          (esc (:subject f))
          (basis-cell f)))

(def ^:private action-gate-rows
  ["        <tr><td><code>:schedule-field-operation</code></td><td><span class=\"ok\">auto-commit when clean (not high-stakes)</span></td></tr>"
   "        <tr><td><code>:log-service-record</code></td><td><span class=\"warn\">ALWAYS human approval (high-stakes actuation)</span></td></tr>"
   "        <tr><td><code>:flag-forest-health-concern</code></td><td><span class=\"warn\">ALWAYS human approval (never auto-resolved)</span></td></tr>"
   "        <tr><td><code>:order-supplies</code></td><td><span class=\"warn\">human approval over cost threshold</span></td></tr>"
   "        <tr><td><code>:operate-chainsaw</code> (etc.)</td><td><span class=\"critical\">HARD out-of-allowlist — direct forestry equipment never in scope</span></td></tr>"])

(defn render [db]
  (let [cur (store/current db)
        ledger (vec (store/ledger db))
        order-ids ["order-001" "order-002" "order-003" "order-004" "order-999"]
        order-rows (str/join "\n" (map #(order-row cur ledger %) order-ids))
        ledger-rows (str/join "\n" (map ledger-row ledger))]
    (str
     "<html><head><meta charset=\"utf-8\"><title>cloud-itonami-isic-0240 · forestrysupport</title><style>\n"
     "body{font:14px/1.5 -apple-system,system-ui,sans-serif;margin:0;color:#1a1a1a;background:#f5f5f5}\n"
     ".bar{background:#1a3a1a;color:#fff;padding:1.2rem 2rem}.bar h1{margin:0;font-size:1.15rem;font-weight:600}\n"
     ".badge{display:inline-block;margin-top:.4rem;font-size:.75rem;opacity:.8}\n"
     "main{max-width:980px;margin:1.5rem auto;padding:0 1rem}\n"
     ".card{background:#fff;border-radius:8px;padding:1.2rem 1.4rem;margin-bottom:1.2rem;box-shadow:0 1px 3px rgba(0,0,0,.08)}\n"
     ".card h2{margin-top:0;font-size:1rem}.muted{color:#777;font-size:.82rem}\n"
     "table{border-collapse:collapse;width:100%;font-size:.85rem}th,td{text-align:left;padding:.42rem .5rem;border-bottom:1px solid #eee}th{font-weight:600;color:#555}\n"
     ".ok{color:#0a7d33}.warn{color:#9a6700}.critical{color:#b41010;font-weight:600}\n"
     "code{background:#f0f0f0;padding:.1rem .3rem;border-radius:3px;font-size:.8rem}\n"
     "</style></head><body>\n"
     "<header class=\"bar\">\n"
     "  <h1>Forestry support ops (ISIC 0240) — Operator Console</h1>\n"
     "  <span class=\"badge\">read-only sample · governor-gated · log-service-record always human-approved · direct equipment permanently blocked</span>\n"
     "</header>\n"
     "<main>\n"
     "  <section class=\"card\">\n"
     "    <h2>Service orders</h2>\n"
     "    <p class=\"muted\">Demo snapshot — build-time-generated from <code>forestrysupport.store</code> via <code>forestrysupport.render-html</code> (<code>kbb -M:dev:render-html</code>), regenerated nightly. No invented data. Domain: <code>forestrysupport</code>.</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Order</th><th>Service type</th><th>Client forest operator</th><th>Flags</th><th>Last op status</th></tr></thead>\n"
     "      <tbody>\n"
     order-rows "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "  <section class=\"card\">\n"
     "    <h2>Action gate (ForestrySupport Governor)</h2>\n"
     "    <p class=\"muted\">HARD holds cannot be overridden. This actor coordinates support services to forestry for OTHER forest operators — it never operates chainsaws/skidders/patrol vehicles and never finalizes fire-suppression tactics.</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Op</th><th>Gate</th></tr></thead>\n"
     "      <tbody>\n"
     (str/join "\n" action-gate-rows) "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "  <section class=\"card\">\n"
     "    <h2>Audit ledger (this run)</h2>\n"
     "    <p class=\"muted\">Append-only decision-fact log — every proposal, hold and commit this scenario produced through the real StateGraph.</p>\n"
     "    <table>\n"
     "      <thead><tr><th>Fact</th><th>Op</th><th>Subject</th><th>Basis</th></tr></thead>\n"
     "      <tbody>\n"
     ledger-rows "\n"
     "      </tbody>\n"
     "    </table>\n"
     "  </section>\n"
     "</main>\n"
     "</body></html>\n")))

(defn -main [& args]
  (let [out (or (first args) "docs/samples/operator-console.html")
        db (run-demo!)
        out-file (java.io.File. out)]
    (.. out-file getParentFile mkdirs)
    (spit out-file (render db))
    (println "wrote" out "(" (count (store/ledger db)) "ledger facts )")))
